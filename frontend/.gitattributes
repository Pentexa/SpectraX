# Normalize line endings: LF in the repository, native on checkout.
* text=auto

# Scripts and configs stay LF everywhere.
*.js text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf

# Windows scripts keep CRLF.
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary assets.
*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary
